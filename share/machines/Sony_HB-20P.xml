<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Sony</manufacturer>
    <code>HB-20P</code>
    <release_year>1986</release_year>
    <description>Basic Spanish MSX with 64kB, like the HB-10P.</description>
    <type>MSX</type>
    <region>es</region>
  </info>

  <CassettePort/>

  <devices>

    <PPI id="ppi">
      <sound>
        <volume>16000</volume>
      </sound>
      <io base="0xA8" num="4"/>
      <keyboard_type>es</keyboard_type>
      <has_keypad>false</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>T6950PAL</version>
      <!-- FERPECT: measured with VRAMMED5 (26-11-2026): one VDP line lasts
           229.23 Z80 cycles in this machine (separate crystals), not 228.
           3579545 * 229.2323 / 228 -->
      <z80_freq_for_vdp_line>3598900</z80_freq_for_vdp_line>
      <io base="0x98" num="2"/>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type> <!-- not checked -->
      <sound>
        <volume>21000</volume>
      </sound>
      <io base="0xA0" num="4" type="IO"/>
      <ignorePortDirections>true</ignorePortDirections> <!-- not sure, but guess based on use of Engine IC -->
    </PSG>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <rom>
          <filename>hb-20p_basic-bios1.rom</filename>
          <sha1>63050d2d21214a721cc55f152c22b7be8061ac33</sha1>
        </rom>
        <mem base="0x0000" size="0x8000"/>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>

    <primary external="true" slot="2"/>

    <primary slot="3">
      <RAM id="Main RAM">
        <mem base="0x0000" size="0x10000"/>
        <!-- FERPECT: measured with MEMINI.COM (26-11-2026) on a real HB-20P,
             cold boot: 128 bytes 00h, 128 bytes FFh, without a single
             deviation from 0000h to BFFFh -->
        <initialContent encoding="gz-base64">eNpjYBhY8H+AAQAioH+B</initialContent>
      </RAM>
    </primary>

  </devices>

</msxconfig>
